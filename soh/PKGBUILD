# Maintainer: ArchLingmo <progsphp@gmail.com>
# Repackages the official upstream Linux AppImage. Ships no game data:
# on first launch it asks for your own Ocarina of Time ROM.

pkgname=soh
pkgver=9.2.3
_codename=Ackbar-Delta
_lusver=fdcaf6336776d24a6408d016b0a52243f108f250
pkgrel=1
pkgdesc="Native port of The Legend of Zelda: Ocarina of Time (Ship of Harkinian; needs your own ROM)"
arch=('x86_64')
url="https://github.com/HarbourMasters/Shipwright"
# Upstream publishes no license for Ship of Harkinian itself;
# libultraship (the engine library) is MIT.
license=('LicenseRef-unknown' 'MIT')
depends=('glibc' 'gcc-libs' 'libglvnd' 'zlib' 'bzip2' 'libzip' 'libpng' 'zenity' 'hicolor-icon-theme')
provides=('shipwright')
conflicts=('soh-bin')
options=('!strip' '!debug')
source=("SoH-$pkgver-Linux.zip::$url/releases/download/$pkgver/SoH-$_codename-Linux.zip"
        "libultraship-LICENSE-$_lusver::https://raw.githubusercontent.com/Kenix3/libultraship/$_lusver/LICENSE"
        "$pkgname.sh"
        "$pkgname.desktop")
sha256sums=('f81cde8052142d6abbbaaffa70699d6748e4cde3f158be8f268c3aab338ee315'
            'fdd4f25c62f0a30865c4395d53e731be208c7b8912d5c068dbd93ca7fadc8a97'
            'e1ce327421e5c454c41d4436165777f3fce604917b1b415bd746115fa9f747a4'
            '7bdacfbd0408f27184abe8a9a0c0270e4627da4f105c86d373d4f39b8caf9d62')

prepare() {
  rm -rf squashfs-root
  chmod +x soh.appimage
  ./soh.appimage --appimage-extract >/dev/null
}

package() {
  install -d "$pkgdir/opt/$pkgname"
  cp -a squashfs-root/usr "$pkgdir/opt/$pkgname/"
  # static lib + headers left over from the upstream build, unused at runtime
  rm -rf "$pkgdir/opt/$pkgname/usr/bin/"{include,lib}
  # desktop integration is installed below under /usr/share
  rm -rf "$pkgdir/opt/$pkgname/usr/share/"{applications,icons,pixmaps}
  chmod -R u=rwX,go=rX "$pkgdir/opt/$pkgname"

  install -Dm755 "$pkgname.sh" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  local f size
  for f in squashfs-root/usr/share/icons/hicolor/*/apps/*; do
    size=${f#squashfs-root/usr/share/icons/hicolor/}; size=${size%%/*}
    install -Dm644 "$f" "$pkgdir/usr/share/icons/hicolor/$size/apps/$pkgname.${f##*.}"
  done

  install -Dm644 readme.txt "$pkgdir/usr/share/doc/$pkgname/README"
  install -Dm644 "libultraship-LICENSE-$_lusver" "$pkgdir/usr/share/licenses/$pkgname/libultraship-LICENSE"
  printf '%s\n' \
    "Ship of Harkinian ($url) does not publish a license for its own code." \
    "This package redistributes the unmodified official release binary." \
    "Bundled third-party library copyrights: /opt/$pkgname/usr/share/doc/" \
    > "$pkgdir/usr/share/licenses/$pkgname/LicenseRef-unknown"
}
